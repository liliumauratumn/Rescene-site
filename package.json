{
  "name": "rescene-fansite",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "update:news": "node scripts/update-news.mjs",
    "update:schedule": "node scripts/update-schedule.mjs",
    "validate:data": "node scripts/validate-content.mjs",
    "check:links": "node scripts/check-links.mjs",
    "test:schedule-safety": "node scripts/test-schedule-safety.mjs",
    "test:schedule-sync-workflow": "node scripts/test-schedule-sync-workflow.mjs",
    "test:schedule-pr-workflow": "node scripts/test-schedule-pr-workflow.mjs",
    "test:next-japan": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --experimental-strip-types scripts/test-next-japan.mjs",
    "verify": "npm run test:schedule-safety && npm run test:schedule-sync-workflow && npm run test:schedule-pr-workflow && npm run test:next-japan && npm run validate:data && npm run typecheck && npm run lint && npm run build && npm run check:links",
    "update": "npm run update:news && npm run update:schedule && npm run verify"
  },
  "dependencies": {
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "20.17.6",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.0",
    "typescript": "5.6.3"
  }
}
